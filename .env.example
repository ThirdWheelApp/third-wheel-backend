# ========================================
# DATABASE CONFIGURATION
# ========================================
# ⚠️ FOR REPLIT: Leave this blank - it will be auto-added to Secrets when you enable PostgreSQL
# ⚠️ FOR LOCAL DEV: Use your local PostgreSQL or get from Supabase dashboard
DATABASE_URL=REPLACE_WITH_YOUR_DATABASE_URL

# ========================================
# SUPABASE CONFIGURATION (AUTH ONLY)
# ========================================
# 📍 Get these from: https://supabase.com → Your Project → Settings → API
# ⚠️ IMPORTANT: We use Supabase for authentication ONLY, not database!

# 1️⃣ Project URL (example: https://abcdefghijklmn.supabase.co)
SUPABASE_URL=https://sqmtqanaoiyubtoajdmi.supabase.co

# 2️⃣ anon/public key (long string starting with: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...)
SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_SUPABASE_ANON_KEY

# 3️⃣ JWT Secret (from: Settings → API → JWT Settings → JWT Secret)
SUPABASE_JWT_SECRET=REPLACE_WITH_YOUR_SUPABASE_JWT_SECRET

# ========================================
# ANTHROPIC API
# ========================================
# 📍 Get your API key from: https://console.anthropic.com/
# ⚠️ Format: sk-ant-api03-...
ANTHROPIC_API_KEY=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

# ========================================
# LLM CONFIGURATION (adjustable)
# ========================================
LLM_MODEL=claude-3-haiku-20240307
LLM_TEMPERATURE=0.7
MAX_TOKENS=1024

# ========================================
# AGENT CONFIGURATION (adjustable)
# ========================================
MAX_AGENT_TURNS=3
MAX_PRIVATE_AGENT_QUERIES=3

# ========================================
# SESSION CONFIGURATION (adjustable)
# ========================================
SESSION_TIMEOUT_MINUTES=30
CHECKIN_APPROVAL_TIMEOUT_DAYS=7

# ========================================
# CONTEXT CONFIGURATION (adjustable)
# ========================================
MAX_CONTEXTS_PER_LOAD=50
SECRET_LEVEL_THRESHOLD=5

# ========================================
# SERVER CONFIGURATION
# ========================================
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# 📍 Comma-separated list of allowed CORS origins (for production)
# ⚠️ Add your frontend URL here when deployed (e.g., https://your-expo-app.com)
ALLOWED_ORIGINS=REPLACE_WITH_YOUR_FRONTEND_URL

# ========================================
# LOGGING CONFIGURATION
# ========================================
LOG_LEVEL=INFO
LOG_FORMAT=json
