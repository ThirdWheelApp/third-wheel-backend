# ========================================
# DATABASE CONFIGURATION
# ========================================
# FOR RAILWAY: Railway automatically provides DATABASE_URL when you add PostgreSQL
# FOR LOCAL DEV: Use your local PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/thirdwheel

# ========================================
# SUPABASE CONFIGURATION (AUTH ONLY)
# ========================================
# Get these from: https://supabase.com → Your Project → Settings → API
# IMPORTANT: We use Supabase for authentication ONLY, not database!

# Project URL (example: https://abcdefghijklmn.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# anon/public key (long string starting with: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...)
SUPABASE_ANON_KEY=your-supabase-anon-key

# JWT Secret (from: Settings → API → JWT Settings → JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Service role key (required for partner invitation emails)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Redirect URL used in partner invitation emails.
# Example:
# INVITE_REDIRECT_URL=https://your-frontend-domain.com
# INVITE_REDIRECT_URL=http://localhost:8082
# INVITE_REDIRECT_URL=thirdwheel://signup
# IMPORTANT: Add the same URL(s) in Supabase Auth Redirect allowlist.
INVITE_REDIRECT_URL=

# ========================================
# DEMO MODE
# ========================================
# Set to true to use mock LLM responses (no API calls)
# Useful for testing without Anthropic API costs
DEMO_MODE=false

# ========================================
# ANTHROPIC API
# ========================================
# Get your API key from: https://console.anthropic.com/
# Format: sk-ant-api03-...
# Optional if DEMO_MODE=true
ANTHROPIC_API_KEY=your-anthropic-api-key

# ========================================
# LLM CONFIGURATION (adjustable)
# ========================================
LLM_MODEL=claude-haiku-4-5-20251001
LLM_TEMPERATURE=0.7
MAX_TOKENS=1024

# ========================================
# AGENT CONFIGURATION (adjustable)
# ========================================
MAX_AGENT_TURNS=3
MAX_PRIVATE_AGENT_QUERIES=3

# ========================================
# SESSION CONFIGURATION (adjustable)
# ========================================
SESSION_TIMEOUT_MINUTES=30
CHECKIN_APPROVAL_TIMEOUT_DAYS=7

# ========================================
# CONTEXT CONFIGURATION (adjustable)
# ========================================
MAX_CONTEXTS_PER_LOAD=50
SECRET_LEVEL_THRESHOLD=5

# ========================================
# SERVER CONFIGURATION
# ========================================
HOST=0.0.0.0
# PORT is set automatically by Railway in production
PORT=8000
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins (for production)
# Add your frontend URL here when deployed
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ========================================
# LOGGING CONFIGURATION
# ========================================
LOG_LEVEL=INFO
LOG_FORMAT=json
