# Replit Configuration for Third Wheel Backend
# FastAPI + PostgreSQL + Supabase Auth

run = "uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
entrypoint = "app/main.py"
language = "python3"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port 8000"]
deploymentTarget = "cloudrun"

[env]
PYTHONPATH = "${REPL_HOME}"
PYTHONUNBUFFERED = "1"

[[ports]]
localPort = 8000
externalPort = 80
exposeLocalhost = true

[packager]
language = "python3"

[packager.features]
enabledForHosting = false
packageSearch = true
guessImports = true

[languages.python3]
pattern = "**/*.py"

[languages.python3.languageServer]
start = "pylsp"

[debugger]
support = true

[debugger.interactive]
transport = "localhost:0"
startCommand = ["dap-python", "app/main.py"]

[debugger.interactive.integratedAdapter]
dapTcpAddress = "localhost:0"

[debugger.interactive.initializeMessage]
command = "initialize"
type = "request"

[debugger.interactive.initializeMessage.arguments]
adapterID = "debugpy"
clientID = "replit"
clientName = "replit.com"
columnsStartAt1 = true
linesStartAt1 = true
locale = "en-us"
pathFormat = "path"
supportsInvalidatedEvent = true
supportsProgressReporting = true
supportsRunInTerminalRequest = true
supportsVariablePaging = true
supportsVariableType = true

[debugger.interactive.launchMessage]
command = "attach"
type = "request"

[debugger.interactive.launchMessage.arguments]
logging = {}

# Git configuration
[gitHubImport]
requiredFiles = [".replit", "requirements.txt", "app/main.py"]

# Unit tests configuration
[unitTest]
language = "python3"

# Object detection for auto-install
[[objectDetection]]
pattern = "import anthropic"
action = "pip install anthropic"

[[objectDetection]]
pattern = "from fastapi"
action = "pip install fastapi"

[[objectDetection]]
pattern = "import sqlalchemy"
action = "pip install sqlalchemy"
